{
  "book": "Metrodorus",
  "chapter": "6",
  "verse_start": "5",
  "verse_end": "9",
  "verses": [
    {
      "verse": "5",
      "text": "Please the Captain in whose army ye serve, from whom also ye will receive your pay."
    },
    {
      "verse": "6",
      "text": "Let none of you be found a deserter."
    },
    {
      "verse": "7",
      "text": "Let your baptism abide with you as your shield;"
    },
    {
      "verse": "8",
      "text": "Your faith as your helmet;"
    },
    {
      "verse": "9",
      "text": "Your love as your spear;"
    }
  ],
  "section": "",
  "date": "2026-11-03"
}