DISCORD_TOKEN=your_discord_bot_token_here

# Runtime data directory (Railway: mount a persistent volume here)
# DATA_DIR=/data

# Theology auto-answer (bot). Also a GitHub Actions secret for Verse of the Day picks.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Extra bot-owner user IDs, comma-separated (the Discord app owner is always one)
# OWNER_IDS=123456789012345678

# Legacy: daily quiz channel. Prefer /setup quiz.
# QUIZ_CHANNEL_ID=123456789012345678

# Optional, verse_of_the_day.py only: post the VOTD card to a webhook too
# (the bot normally posts it; the workflow doesn't set this)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
